            <longitude xsi:type="double">8.23940</longitude>
            <altitude xsi:type="double">0.0</altitude>
          </value>
        </waypoint>
      </route>
      <acceleration xsi:type="double">0</acceleration>
      <behaviour xsi:type="observingSimpleFollowRouteBehaviour"/>
      <course xsi:type="double">135.0</course>
      
      <observedTypes>
        <observedType>
          <name>generalCargoShip</name>
          <attributes>
            <attribute>name</attribute>
            <attribute>position</attribute>
          </attributes>
        </observedType>
      </observedTypes>
    </element>
    <element xsi:type="generalCargoShip" timeStepSize="1">
