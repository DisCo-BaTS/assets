<scenario>
    <library>
        <name>maritime_library</name>
        <version>0.1-SNAPSHOT</version>
    </library>
    <observers>
        <globalObserver>
            <observedClasses>
                <observedClass>
                    <type>vessel</type>
                    <attributes>
                        <attribute>position</attribute>
                        <attribute>name</attribute>
                        <attribute>speed</attribute>
                        <attribute>acceleration</attribute>
                    </attributes>
                </observedClass>
            </observedClasses>
            <timeStepSize>1</timeStepSize>
            <observerWebSocketConfig>
                <address>localhost</address>
                <port>3001</port>
            </observerWebSocketConfig>
            <outputTypes>
                <outputType>CONSOLE</outputType>
            </outputTypes>
        </globalObserver>
    </observers>
    <elements>
        <!-- Test Vessel für AccelerationBehaviour -->
        <element xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="vessel">
            <physical>
                <id>vessel1-phys-001</id>
                <attributeType>SINGLE</attributeType>
                <unit xsi:type="noUnit">
                    <abbreviation>nau</abbreviation>
                    <name>no unit</name>
                    <unitToBase>1.0</unitToBase>
                </unit>
                <value xmlns:xs="http://www.w3.org/2001/XMLSchema" xsi:type="xs:boolean">false</value>
                <name>physical</name>
                <dataType>java.lang.Boolean</dataType>
                <publish>true</publish>
            </physical>
            <position>
                <id>vessel1-pos-001</id>
                <attributeType>SINGLE</attributeType>
                <unit xsi:type="noUnit">
                    <abbreviation>nau</abbreviation>
                    <name>no unit</name>
                    <unitToBase>1.0</unitToBase>
                </unit>
                <value xsi:type="position">
                    <id>vessel1-pos-inner-001</id>
                    <latitude>
                        <id>vessel1-lat-001</id>
                        <attributeType>SINGLE</attributeType>
                        <unit xsi:type="noUnit">
                            <abbreviation>nau</abbreviation>
                            <name>no unit</name>
                            <unitToBase>1.0</unitToBase>
                        </unit>
                        <value xmlns:xs="http://www.w3.org/2001/XMLSchema" xsi:type="xs:double">53.5</value>
                        <name>position.latitude</name>
                        <dataType>java.lang.Double</dataType>
                        <publish>true</publish>
                    </latitude>
                    <longitude>
                        <id>vessel1-lon-001</id>
                        <attributeType>SINGLE</attributeType>
                        <unit xsi:type="noUnit">
                            <abbreviation>nau</abbreviation>
                            <name>no unit</name>
                            <unitToBase>1.0</unitToBase>
                        </unit>
                        <value xmlns:xs="http://www.w3.org/2001/XMLSchema" xsi:type="xs:double">8.0</value>
                        <name>position.longitude</name>
                        <dataType>java.lang.Double</dataType>
                        <publish>true</publish>
                    </longitude>
                    <altitude>
                        <id>vessel1-alt-001</id>
                        <attributeType>SINGLE</attributeType>
                        <unit xsi:type="distanceUnit">
                            <abbreviation>m</abbreviation>
                            <name>meter</name>
                            <unitToBase>1.0</unitToBase>
                        </unit>
                        <value xmlns:xs="http://www.w3.org/2001/XMLSchema" xsi:type="xs:double">0.0</value>
                        <name>position.altitude</name>
                        <dataType>java.lang.Double</dataType>
                        <publish>true</publish>
                    </altitude>
                </value>
                <name>position</name>
                <dataType>library.model.simulation.Position</dataType>
                <publish>true</publish>
            </position>
            <rotation>
                <id>vessel1-rot-001</id>
                <attributeType>SINGLE</attributeType>
                <unit xsi:type="rotationUnit">
                    <abbreviation>°</abbreviation>
                    <name>degree</name>
                    <unitToBase>1.0</unitToBase>
                </unit>
                <value xmlns:xs="http://www.w3.org/2001/XMLSchema" xsi:type="xs:double">45.0</value>
                <name>rotation</name>
                <dataType>java.lang.Double</dataType>
                <publish>true</publish>
            </rotation>
            <formString>POLYGON ((0 0, 20 0, 20 150, 0 150, 0 0))</formString>
            <limitations/>
            <assignedDomain>
                <id>vessel1-dom-001</id>
                <attributeType>SINGLE</attributeType>
                <unit xsi:type="noUnit">
                    <abbreviation>nau</abbreviation>
                    <name>no unit</name>
                    <unitToBase>1.0</unitToBase>
                </unit>
                <value xsi:type="trafficDomain">MARITIME</value>
                <name>assignedDomain</name>
                <dataType>library.model.traffic.PossibleDomains</dataType>
                <publish>true</publish>
            </assignedDomain>
            <speed>
                <id>vessel1-speed-001</id>
                <attributeType>SINGLE</attributeType>
                <unit xsi:type="speedUnit">
                    <abbreviation>m/s</abbreviation>
                    <name>meters per second</name>
                    <unitToBase>1.0</unitToBase>
                </unit>
                <value xmlns:xs="http://www.w3.org/2001/XMLSchema" xsi:type="xs:double">0.0</value>
                <name>speed</name>
                <dataType>java.lang.Double</dataType>
                <publish>true</publish>
            </speed>
            <acceleration>
                <id>vessel1-accel-001</id>
                <attributeType>SINGLE</attributeType>
                <unit xsi:type="accelerationUnit">
                    <abbreviation>m/s^2</abbreviation>
                    <name>meters per second squared</name>
                    <unitToBase>1.0</unitToBase>
                </unit>
                <value xmlns:xs="http://www.w3.org/2001/XMLSchema" xsi:type="xs:double">0.5</value>
                <name>acceleration</name>
                <dataType>java.lang.Double</dataType>
                <publish>true</publish>
            </acceleration>
            <behaviour xsi:type="accelerationBehaviour">
                <id>vessel1-behav-001</id>
                <isSystemUnderTest>false</isSystemUnderTest>
                <goals/>
                <targetSpeed>10.0</targetSpeed>
            </behaviour>
            <length>
                <id>vessel1-len-001</id>
                <attributeType>SINGLE</attributeType>
                <unit xsi:type="distanceUnit">
                    <abbreviation>m</abbreviation>
                    <name>meter</name>
                    <unitToBase>1.0</unitToBase>
                </unit>
                <value xmlns:xs="http://www.w3.org/2001/XMLSchema" xsi:type="xs:double">150.0</value>
                <name>length</name>
                <dataType>java.lang.Double</dataType>
                <publish>true</publish>
            </length>
            <maxSpeed>
                <id>vessel1-maxspeed-001</id>
                <attributeType>SINGLE</attributeType>
                <unit xsi:type="speedUnit">
                    <abbreviation>kn</abbreviation>
                    <name>knots</name>
                    <unitToBase>0.5144444444444445</unitToBase>
                </unit>
                <value xmlns:xs="http://www.w3.org/2001/XMLSchema" xsi:type="xs:double">20.0</value>
                <name>maxSpeed</name>
                <dataType>java.lang.Double</dataType>
                <publish>true</publish>
            </maxSpeed>
            <draught>
                <id>vessel1-draught-001</id>
                <attributeType>SINGLE</attributeType>
                <unit xsi:type="distanceUnit">
                    <abbreviation>m</abbreviation>
                    <name>meter</name>
                    <unitToBase>1.0</unitToBase>
                </unit>
                <value xmlns:xs="http://www.w3.org/2001/XMLSchema" xsi:type="xs:double">8.0</value>
                <name>draught</name>
                <dataType>java.lang.Double</dataType>
                <publish>true</publish>
            </draught>
            <width>
                <id>vessel1-width-001</id>
                <attributeType>SINGLE</attributeType>
                <unit xsi:type="distanceUnit">
                    <abbreviation>m</abbreviation>
                    <name>meter</name>
                    <unitToBase>1.0</unitToBase>
                </unit>
                <value xmlns:xs="http://www.w3.org/2001/XMLSchema" xsi:type="xs:double">25.0</value>
                <name>width</name>
                <dataType>java.lang.Double</dataType>
                <publish>true</publish>
            </width>
            <course>
                <id>vessel1-course-001</id>
                <attributeType>SINGLE</attributeType>
                <unit xsi:type="rotationUnit">
                    <abbreviation>°</abbreviation>
                    <name>degree</name>
                    <unitToBase>1.0</unitToBase>
                </unit>
                <value xmlns:xs="http://www.w3.org/2001/XMLSchema" xsi:type="xs:double">45.0</value>
                <name>course</name>
                <dataType>java.lang.Double</dataType>
                <publish>true</publish>
            </course>
            <homeHarbour>
                <id>vessel1-harbour-001</id>
                <attributeType>SINGLE</attributeType>
                <unit xsi:type="noUnit">
                    <abbreviation>nau</abbreviation>
                    <name>no unit</name>
                    <unitToBase>1.0</unitToBase>
                </unit>
                <value xmlns:xs="http://www.w3.org/2001/XMLSchema" xsi:type="xs:string">Hamburg</value>
                <name>homeHarbour</name>
                <dataType>java.lang.String</dataType>
                <publish>true</publish>
            </homeHarbour>
            <name>
                <id>vessel1-name-001</id>
                <attributeType>SINGLE</attributeType>
                <unit xsi:type="noUnit">
                    <abbreviation>nau</abbreviation>
                    <name>no unit</name>
                    <unitToBase>1.0</unitToBase>
                </unit>
                <value xmlns:xs="http://www.w3.org/2001/XMLSchema" xsi:type="xs:string">Acceleration Test Ship</value>
                <name>name</name>
                <dataType>java.lang.String</dataType>
                <publish>true</publish>
            </name>
            <maxAcceleration>
                <id>vessel1-maxaccel-001</id>
                <attributeType>SINGLE</attributeType>
                <unit xsi:type="accelerationUnit">
                    <abbreviation>m/s^2</abbreviation>
                    <name>meters per second squared</name>
                    <unitToBase>1.0</unitToBase>
                </unit>
                <value xmlns:xs="http://www.w3.org/2001/XMLSchema" xsi:type="xs:double">0.5</value>
                <name>maxAcceleration</name>
                <dataType>java.lang.Double</dataType>
                <publish>true</publish>
            </maxAcceleration>
            <inertia>
                <id>vessel1-inertia-001</id>
                <attributeType>SINGLE</attributeType>
                <unit xsi:type="noUnit">
                    <abbreviation>nau</abbreviation>
                    <name>no unit</name>
                    <unitToBase>1.0</unitToBase>
                </unit>
                <value xmlns:xs="http://www.w3.org/2001/XMLSchema" xsi:type="xs:double">0.3</value>
                <name>inertia</name>
                <dataType>java.lang.Double</dataType>
                <publish>true</publish>
            </inertia>
        </element>
    </elements>
</scenario>

